  "templates": [
    {
      "id": "bcc-tools-execsnoop",
      "name": "BCC execsnoop",
      "description": "Monitor process execution using BCC tools style execsnoop implementation",
      "category": "observability",
      "software": "BCC Tools",
      "tags": ["BCC", "process", "monitoring", "execve"],
      "initialNodes": [
        {
          "id": "attach-1",
          "type": "attachment",
          "position": { "x": 100, "y": 100 },
          "data": {
            "label": "Attach to execve",
            "attachmentType": "TRACEPOINT",
            "targetFunction": "syscalls:sys_enter_execve"
          }
        },
        {
          "id": "var-1",
          "type": "variable", 
          "position": { "x": 300, "y": 100 },
          "data": {
            "label": "Get PID",
            "variableType": "u32",
            "operation": "bpf_get_current_pid_tgid",
            "name": "pid"
          }
        },
        {
          "id": "var-2",
          "type": "variable",
          "position": { "x": 500, "y": 100 },
          "data": {
            "label": "Get Command",
            "variableType": "char[256]",
            "operation": "bpf_get_current_comm",
            "name": "comm"
          }
        },
        {
          "id": "output-1",
          "type": "output",
          "position": { "x": 700, "y": 100 },
          "data": {
            "label": "Print Execution Event",
            "outputType": "bpf_trace_printk",
            "format": "PID %d executed: %s"
          }
        }
      ],
      "initialEdges": [
        {"id": "e1", "source": "attach-1", "target": "var-1"},
        {"id": "e2", "source": "var-1", "target": "var-2"},
        {"id": "e3", "source": "var-2", "target": "output-1"}
      ]
    },
    {
