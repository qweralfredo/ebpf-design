    {
      "id": "cilium-cni-network",
      "name": "Cilium CNI Network Policy", 
      "description": "Implement network policies using Cilium-style eBPF for Kubernetes",
      "category": "networking",
      "software": "Cilium",
      "tags": ["Cilium", "CNI", "Kubernetes", "network-policy"],
      "initialNodes": [
        {
          "id": "attach-1",
          "type": "attachment",
          "position": { "x": 100, "y": 100 },
          "data": {
            "label": "XDP Ingress",
            "attachmentType": "XDP",
            "targetFunction": "cilium_xdp_ingress",
            "interface": "eth0"
          }
        },
        {
          "id": "packet-1",
          "type": "packet",
          "position": { "x": 300, "y": 100 },
          "data": {
            "label": "Parse Ethernet",
            "accessType": "ETHERNET_HEADER",
            "field": "h_proto"
          }
        },
        {
          "id": "conditional-1",
          "type": "conditional",
          "position": { "x": 500, "y": 100 },
          "data": {
            "label": "Check IP protocol",
            "condition": "protocol",
            "operator": "==",
            "value": "ETH_P_IP"
          }
        },
        {
          "id": "map-1",
          "type": "mapAction",
          "position": { "x": 700, "y": 50 },
          "data": {
            "label": "Policy lookup",
            "mapType": "BPF_MAP_TYPE_HASH",
            "operation": "lookup",
            "keyType": "struct endpoint_key",
            "valueType": "struct policy_entry"
          }
        },
        {
          "id": "return-1",
          "type": "return",
          "position": { "x": 900, "y": 50 },
          "data": {
            "label": "Allow/Drop",
            "action": "XDP_PASS/XDP_DROP",
            "returnCode": "policy_decision"
          }
        }
      ],
      "initialEdges": [
        {"id": "e1", "source": "attach-1", "target": "packet-1"},
        {"id": "e2", "source": "packet-1", "target": "conditional-1"},
        {"id": "e3", "source": "conditional-1", "target": "map-1", "label": "IP"},
        {"id": "e4", "source": "map-1", "target": "return-1"}
      ]
    },
